# Example credentials file for BoardSim.
#
# This is the file config.local.php points at (key `secrets_file`). Keep the real
# copy in ~/boardsim-secrets/boardsim.env, mode 600, owned by the service account,
# never in the repository and never under the document root.
#
# Plain KEY=VALUE, one per line, `#` for comments. The DSN contains semicolons by
# design and needs no quoting. A value already present in the process environment
# wins over this file.
#
# 1 enables the on-disk development stores. Never present on a public host.
BOARDSIM_DSN=mysql:host=localhost;dbname=iliadis_boardsim;charset=utf8mb4
BOARDSIM_USER=iliadis_boardsim_api
BOARDSIM_PASS=change-me

# 1 enables the on-disk development stores. Never set on a public host.
#BOARDSIM_DEV=1