# BoardSim — same-origin routing
#
# The SPA and the API share one origin (boardsim.iliadis.net), so there is no
# CORS configuration and no cross-site cookie. Everything under /v1 goes to the
# front controller; everything else resolves to the built SPA.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # API first, so /v1 is never captured by the SPA fallback.
  #
  # A per-directory rewrite re-enters this ruleset, so when api/index.php is not
  # installed the rewritten request falls through to the SPA fallback below and
  # /v1 is answered with index.html and HTTP 200. The browser then reports
  # "Unexpected token '<'" and the footer claims the scoring policy is
  # unavailable, which reads like a front-end defect rather than a missing shim.
  # The guard below turns that silence into a 503 instead.
  RewriteRule ^v1(/.*)?$ api/index.php [QSA,L]

  # The shell is one document served at /. The build puts it in app/index.html,
  # so without this the same HTML answers at two addresses, splitting inbound
  # links and handing a crawler a duplicate. THE_REQUEST matches only the
  # client's original request, so the internal rewrite below is unaffected.
  RewriteCond %{THE_REQUEST} \s/+app/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # api/index.php must exist (installed from deploy/api-index-shim.php). If it
  # does not, fail loudly; never answer an API path with a static page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/index\.php$ - [R=503,L]

  # The document root itself is a directory, so the "-d" branch below would stop
  # this ruleset and leave Apache looking for a DirectoryIndex that the build never
  # creates: the shell lives at app/index.html. With Options -Indexes, "no index and
  # no listing" is a 403, which is exactly what every crawler received on "/" while
  # the page looked fine in a browser (the host renders 403 with the app shell).
  # The empty path can only match here, before the real-file test.
  RewriteRule ^$ app/index.html [L]

  # A discovery file that is not on disk must not be answered by the SPA fallback.
  # /robots.txt returning index.html with HTTP 200 tells a crawler the site has no
  # policy, and looks like success in a browser; 404 is the truth, and it is what a
  # deploy that forgot the files should produce.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(robots\.txt|sitemap\.xml|llms\.txt)$ - [R=404,L]

  # Real files (hashed assets, favicon) are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA history fallback. Build output lives in public/app (see web/vite.config.ts).
  # /v1 stays excluded outright: a static page is never a valid API answer.
  RewriteCond %{REQUEST_URI} !^/v1(/|$)
  RewriteRule ^ app/index.html [L]
</IfModule>

# Never serve dotfiles.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# The document root's pointer to the backend (generated by bin/build-deploy.php).
# It holds a filesystem path, not a secret, but there is no reason to serve it:
# `require` reads the file directly, so denying HTTP access costs nothing.
<Files "backend.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  # Must match BoardSim\Http\SecurityHeaders::CONTENT_SECURITY_POLICY.
  # bin/verify-http.php fails if these drift apart.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
  # Only enable on an HTTPS-only origin; see docs/security-headers.md.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(js|css|woff2|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Discovery files are cheap and change with a deploy, so cache them briefly
  # instead of immutably. llms.txt is stated as plain text so no agent has to
  # guess, and sitemap.xml must never be sniffed as HTML.
  <FilesMatch "^(robots\.txt|llms\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <Files "llms.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>
</IfModule>

Options -Indexes
